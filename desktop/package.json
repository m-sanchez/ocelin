{
  "name": "ocelin-desktop",
  "productName": "Ocelin",
  "version": "0.7.0-preview.2",
  "description": "Ocelin: a local Windows companion for Codex and Claude",
  "private": true,
  "main": "main.cjs",
  "author": "Miguel Sanchez",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "pack": "node prepare.mjs && electron-builder --config electron-builder.config.cjs --dir --win --publish never",
    "dist": "node prepare.mjs && electron-builder --config electron-builder.config.cjs --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uk.co.miguelsanchez.ocelin",
    "productName": "Ocelin",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "smoke.cjs",
      "lib/**",
      "renderer/**",
      "assets/**",
      "integrations/**",
      "package.json"
    ],
    "asarUnpack": [
      "lib/verify-update.ps1",
      "lib/resources.ps1",
      "lib/stop-processes.ps1"
    ],
    "extraResources": [
      {
        "from": "assets/ocelin.ico",
        "to": "assets/ocelin.ico"
      },
      {
        "from": "native/activate.ps1",
        "to": "native/activate.ps1"
      },
      {
        "from": "../",
        "to": "core",
        "filter": [
          "server/**",
          "ui/**",
          "hooks/**",
          "scripts/**",
          "contracts/**",
          "schemas/**",
          "reference/**",
          "command-templates/**",
          "package.json",
          "panel.config.json",
          "README.md",
          "ARCHITECTURE.md",
          "LICENSE"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Ocelin conversation links",
        "schemes": [
          "ocelin"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/ocelin.ico",
      "artifactName": "Ocelin-${version}-${arch}-setup.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Ocelin",
      "installerIcon": "assets/ocelin.ico",
      "uninstallerIcon": "assets/ocelin.ico",
      "installerHeaderIcon": "assets/ocelin.ico",
      "uninstallDisplayName": "Ocelin"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
